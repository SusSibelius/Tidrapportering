# Slumpmässig hemlighet för sessionskakan, t.ex. från: npx auth secret
AUTH_SECRET=

# Appregistrering i Microsoft Entra ID (se README)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Katalog-ID (tenant). Utelämna för att tillåta alla organisationskonton.
AUTH_MICROSOFT_ENTRA_ID_TENANT=

# Utan nyckel görs förslagen bara med regler
ANTHROPIC_API_KEY=
